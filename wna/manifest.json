{
  "manifest_version": 3,
  "name": "AGRINEXO WNA WebMCP Nano Agent",
  "version": "0.1.0",
  "description": "WebMCP consumer over an OpenAI-compatible model API. Works on any page that registers tools.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open AGRINEXO WNA"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
